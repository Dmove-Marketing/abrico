---
import Base from '../layouts/Base.astro';
import config from '../../config.json';
import '../styles/index.css';
import '../styles/bio.css';

// media.dmove.com.br redimensiona on-the-fly: /api/public/resize/<w>/clients/...
const R = (w: number, path: string) =>
  `https://media.dmove.com.br/api/public/resize/${w}/clients/${path}`;
const srcset = (path: string, ws: number[]) =>
  ws.map((w) => `${R(w, path)} ${w}w`).join(', ');
const LOGO_SRC = R(320, 'abrico/photos/Logo_Abrico.webp');
const HERO_PATH = 'abrico/photos/steeivan-285.webp';
const HERO_SRC = R(1400, HERO_PATH);
const HERO_SRCSET = srcset(HERO_PATH, [640, 900, 1200, 1600, 2000]);
const DMOVE_LOGO = R(160, 'dmove/photos/imgi_73_Versao-Principal-scaled-e1750426923582.webp');
const MAPS_URL = 'https://maps.app.goo.gl/ZgCbPQFkrQ3bACBeA';
---

<Base
  title="Espaço Abricó · Casamentos à beira-mar em São Sebastião"
  description="Um destination wedding onde a praia faz parte da experiência. Espaço Abricó, casamentos à beira-mar no litoral norte de São Paulo."
  ogImage="/images/og-index.jpg"
  noIndex={true}
>

  <!-- HERO -->
  <section class="bio-hero">
    <img src={HERO_SRC} srcset={HERO_SRCSET} sizes="100vw" alt="Cerimônia à beira-mar no Espaço Abricó" class="bio-hero-img" fetchpriority="high" style="object-position: center center;" />
    <div class="bio-hero-overlay"></div>
    <div class="bio-hero-logo">
      <img src={LOGO_SRC} alt="Espaço Abricó" class="bio-logo" />
    </div>
    <div class="bio-hero-content">
      <span class="bio-eyebrow">São Sebastião · Litoral Norte de SP</span>
      <h1 class="bio-headline">Um espaço pé na areia, feito para quem não quer um evento comum</h1>
      <p class="bio-subline">Celebre no litoral norte, com estrutura completa e hospedagem à beira-mar</p>
    </div>
  </section>

  <!-- BOTÕES -->
  <div class="bio-links-section">
    <div class="bio-links">
      <!-- TODO: adicione os botões aqui -->
    </div>
  </div>

  <!-- ENDEREÇO -->
  <div class="bio-links-section" style="padding-top:0;">
    <div class="bio-links">
      <a href={MAPS_URL} target="_blank" rel="noopener" class="bio-link-btn">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7z"/><circle cx="12" cy="9" r="2.5"/></svg>
        Nossa localização
      </a>
    </div>
  </div>

  <!-- FORMULÁRIO -->
  <section class="bio-form-section" id="solicitar">
    <p class="bio-section-label">Contato</p>
    <h2 class="bio-section-title">Solicite um orçamento</h2>

    <div class="bio-form-card">
      <form
        id="bioContactForm"
        data-form-id="lead-form-bio"
        data-project={config.project_slug}
        data-submit-url={config.forms['lead-form'].webhooks[0]}
        data-redirect={config.forms['lead-form'].redirect_on_success}
        data-success-id="bioFormSuccess"
        novalidate
      >
        <div class="hp-field" aria-hidden="true">
          <input type="text" name="website" tabindex="-1" autocomplete="off" />
        </div>
        <div class="form-grid">
          <div class="field field--full">
            <label for="bio-nome">Nome</label>
            <input type="text" id="bio-nome" name="Nome" autocomplete="name" required>
          </div>
          <div class="field">
            <label for="bio-telefone">Telefone</label>
            <input type="tel" id="bio-telefone" name="WhatsApp" autocomplete="tel" required data-mask="phone">
          </div>
          <div class="field">
            <label for="bio-email">E-mail</label>
            <input type="email" id="bio-email" name="E-mail" autocomplete="email" required>
          </div>
          <div class="field">
            <label for="bio-data">Data do evento</label>
            <input type="text" id="bio-data" name="Data do evento" placeholder="dd/mm/aaaa" autocomplete="off" data-datepicker readonly required>
          </div>
          <div class="field">
            <label for="bio-pessoas">Número de pessoas</label>
            <input type="number" id="bio-pessoas" name="Convidados" min="1" placeholder="Ex: 80" required>
          </div>
          <div class="field field--full">
            <label for="bio-tipo">Tipo de evento</label>
            <select id="bio-tipo" name="Tipo de evento" required>
              <option value="">Selecione uma opção</option>
              <option value="Bodas">Bodas</option>
              <option value="Casamento">Casamento</option>
              <option value="Confraternização social">Confraternização social</option>
              <option value="Outros">Outros</option>
            </select>
          </div>
          <div class="field field--full">
            <label for="bio-detalhes">Detalhes adicionais</label>
            <textarea id="bio-detalhes" name="Mensagem" placeholder="Conte um pouco sobre o evento que você imagina..."></textarea>
          </div>
        </div>
        <button type="button" class="bio-submit form-submit">
          Enviar solicitação
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="width:15px;height:15px;"><path d="M7 17L17 7M17 7H9M17 7V15"/></svg>
        </button>
      </form>
      <div class="bio-form-success" id="bioFormSuccess">
        <h3>Recebemos sua solicitação.</h3>
        <p>Em breve nossa equipe entrará em contato para conversar sobre a data perfeita.</p>
      </div>
    </div>
  </section>

  <!-- FOOTER -->
  <footer class="bio-footer">
    <div class="bio-footer__top">
      <img src={LOGO_SRC} alt="Espaço Abricó" class="bio-footer__logo" />
      <div class="bio-social">
        <a href={MAPS_URL} target="_blank" rel="noopener" class="bio-social-btn" aria-label="Localização">
          <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" width="17" height="17">
            <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/>
          </svg>
        </a>
        <a href="https://www.instagram.com/espacoabrico/" target="_blank" rel="noopener" class="bio-social-btn" aria-label="Instagram">
          <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" width="17" height="17">
            <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
          </svg>
        </a>
        <a href="https://espacoabrico.com.br" target="_blank" rel="noopener" class="bio-social-btn" aria-label="Site">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" width="17" height="17">
            <circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/>
            <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/>
          </svg>
        </a>
      </div>
      <div class="bio-footer__bottom">
        <p class="bio-footer__copy">&copy; 2026 Espaço Abricó. Todos os direitos reservados.</p>
        <a href="https://dmove.com.br" target="_blank" rel="noopener" class="bio-footer__dmove">
          Desenvolvido por
          <img src={DMOVE_LOGO} alt="Dmove" class="bio-footer__dmove-logo" width="60" height="13" />
        </a>
      </div>
    </div>
  </footer>

</Base>

<script>
  import { initForms } from '../scripts/forms.ts';
  import { initDatepickers } from '../scripts/datepicker.ts';

  function applyPhoneMask(input: HTMLInputElement) {
    input.addEventListener('input', () => {
      let v = input.value.replace(/\D/g, '').slice(0, 11);
      if (v.length > 10) v = v.replace(/^(\d{2})(\d{5})(\d{4}).*/, '($1) $2-$3');
      else if (v.length > 6) v = v.replace(/^(\d{2})(\d{4})(\d*)/, '($1) $2-$3');
      else if (v.length > 2) v = v.replace(/^(\d{2})(\d*)/, '($1) $2');
      else if (v.length > 0) v = v.replace(/^(\d*)/, '($1');
      input.value = v;
    });
  }

  function init() {
    initForms();
    initDatepickers();

    document.querySelectorAll<HTMLInputElement>('[data-mask="phone"]').forEach((el) => {
      if (el.dataset.maskInit) return;
      el.dataset.maskInit = '1';
      applyPhoneMask(el);
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }
</script>
