<style is:global>
  /* Flatpickr — tema escuro para seção contato */
  .flatpickr-calendar {
    background: #1c1a14;
    border: 1px solid rgba(255,255,255,.12);
    border-radius: 0;
    box-shadow: 0 16px 48px rgba(0,0,0,.55);
    font-family: var(--font-body);
  }
  .flatpickr-calendar.arrowTop::before,
  .flatpickr-calendar.arrowTop::after { border-bottom-color: #1c1a14; }
  .flatpickr-calendar.arrowBottom::before,
  .flatpickr-calendar.arrowBottom::after { border-top-color: #1c1a14; }

  .flatpickr-months { padding: .5rem 0 0; }
  .flatpickr-month { color: #FFFDF8; fill: #FFFDF8; }
  .flatpickr-current-month { font-size: .95rem; font-weight: 500; color: #FFFDF8; }
  .flatpickr-current-month .flatpickr-monthDropdown-months,
  .flatpickr-current-month input.cur-year { color: #FFFDF8; background: transparent; }
  .flatpickr-prev-month, .flatpickr-next-month { color: rgba(255,255,255,.6); fill: rgba(255,255,255,.6); }
  .flatpickr-prev-month:hover, .flatpickr-next-month:hover { color: #FFFDF8; fill: #FFFDF8; }

  .flatpickr-weekdays { background: transparent; }
  span.flatpickr-weekday { color: rgba(255,255,255,.4); font-size: .72rem; letter-spacing: .1em; text-transform: uppercase; }

  .flatpickr-day { color: rgba(255,255,255,.78); border-radius: 0; }
  .flatpickr-day:hover { background: rgba(255,255,255,.08); border-color: transparent; color: #FFFDF8; }
  .flatpickr-day.today { border-color: rgba(51,81,63,.7); }
  .flatpickr-day.today:hover { background: rgba(51,81,63,.3); border-color: transparent; }
  .flatpickr-day.selected,
  .flatpickr-day.selected:hover { background: #33513F; border-color: #33513F; color: #FFFDF8; }
  .flatpickr-day.flatpickr-disabled,
  .flatpickr-day.prevMonthDay,
  .flatpickr-day.nextMonthDay { color: rgba(255,255,255,.18); }
</style>
<script>
  import '../scripts/index.js';
  import { initForms } from '../scripts/forms.ts';
  import flatpickr from 'flatpickr';
  import { Portuguese } from 'flatpickr/dist/l10n/pt.js';
  import 'flatpickr/dist/flatpickr.min.css';

  flatpickr.localize(Portuguese);

  function applyPhoneMask(input: HTMLInputElement) {
    input.addEventListener('input', () => {
      let v = input.value.replace(/\D/g, '').slice(0, 11);
      if (v.length > 10) v = v.replace(/^(\d{2})(\d{5})(\d{4}).*/, '($1) $2-$3');
      else if (v.length > 6) v = v.replace(/^(\d{2})(\d{4})(\d*)/, '($1) $2-$3');
      else if (v.length > 2) v = v.replace(/^(\d{2})(\d*)/, '($1) $2');
      else if (v.length > 0) v = v.replace(/^(\d*)/, '($1');
      input.value = v;
    });
  }

  function initPhoneMasks() {
    document.querySelectorAll<HTMLInputElement>('[data-mask="phone"]').forEach((el) => {
      if (el.dataset.maskInit) return;
      el.dataset.maskInit = '1';
      applyPhoneMask(el);
    });
  }

  function initDatepickers() {
    document.querySelectorAll<HTMLInputElement>('[data-datepicker]').forEach((el) => {
      if ((el as any)._flatpickr) return;
      flatpickr(el, { dateFormat: 'd/m/Y', minDate: 'today', disableMobile: false });
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', () => { initForms(); initDatepickers(); initPhoneMasks(); });
  } else {
    initForms();
    initDatepickers();
    initPhoneMasks();
  }
</script>
